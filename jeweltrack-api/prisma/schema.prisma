generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// db start

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  MANAGER
  CASHIER
}

enum Purity {
  K22
  K18
  K24
}

enum Metal {
  GOLD
  SILVER
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum Type {
  IN
  OUT
}

enum StockType {
  OWN
  BORROW
}

enum ReferenceType {
  BILL
  ADJUSTMENT
  ADD
}

enum subscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

model User {
  id                  String                @id @default(uuid())
  shop_id             String?
  shop                Shop?                 @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  
  name                String
  phone               String                @unique
  email               String?               @unique
  password            String
  role                Role                  @default(SHOP_OWNER)
  is_active           Boolean               @default(true)
  
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  createdBills        Bill[]                @relation("BillCreatedByUser")
  createdPayments     BillPaymentsEntry[]   @relation("PaymentCreatedByUser")
  createdStockEntries InventoryStockEntry[] @relation("StockCreatedByUser")
  createdApprovals    ApprovalMemo[]        @relation("ApprovalCreatedByUser")
  createdSettlements  DealerSettlement[]    @relation("SettlementCreatedByUser")
  createdSchemes         GoldSavingsAccount[] @relation("SchemeCreatedByUser")
  createdSchemePayments  GoldSavingsPayment[] @relation("SchemePaymentCreatedByUser")
  createdSchemeRedemptions GoldSavingsRedemption[] @relation("SchemeRedemptionCreatedByUser")

  @@index([shop_id])
  @@index([phone])
}

model Shop {
  id                  String             @id @default(uuid())
  name                String
  subscription_plan   String             @default("TRIAL")
  subscription_status subscriptionStatus @default(TRIAL)
  created_at          DateTime           @default(now())

  users               User[]
  customer            Customer[] 
  rate                Rate[]
  bill                Bill[]
  jewelleryCategory   JewelleryCategory[]
  goldLoan            JewelLoan[]
  inventoryStockEntry InventoryStockEntry[]
  billPaymentsEntry   BillPaymentsEntry[]
  oldGoldEntry        OldGoldEntry[]
  shopSetting         ShopSetting?
  subscription        Subscription[] 
  dealers             Dealer[]
  approvalMemos       ApprovalMemo[]
  dealerSettlements   DealerSettlement[]
  goldSavingsAccounts    GoldSavingsAccount[]
  goldSavingsPayments    GoldSavingsPayment[]
  goldSavingsRedemptions GoldSavingsRedemption[]
}

model Customer {
  id         String   @id @default(uuid())
  shop_id    String 
  shop       Shop     @relation(fields: [shop_id], references: [id])
  name       String 
  phone      String
  village    String
  address    String?
  created_at DateTime @default(now())

  bill       Bill[]
  goldLoan   JewelLoan[]
  goldSavingsAccounts GoldSavingsAccount[]

  @@index([shop_id])
}

model Rate {
  id          String   @id @default(uuid())
  shop_id     String 
  shop        Shop     @relation(fields: [shop_id], references: [id])
  rate_22k    Int 
  rate_18k    Int
  rate_999    Int?
  rate_silver Int
  created_at  DateTime @default(now())
}

model Bill {
  id                  String              @id @default(uuid())
  shop_id             String 
  shop                Shop                @relation(fields: [shop_id], references: [id])
  customer_id         String
  customer            Customer            @relation(fields: [customer_id], references: [id])
  bill_number         String
  is_gst_bill         Boolean             @default(false)
  total_amount        Float 
  discount            Float?              @default(0)
  totalGST            Float?              @default(0)
  payableAmount       Float
  notes               String?
  created_by_user_id  String?
  created_by          User?               @relation("BillCreatedByUser", fields: [created_by_user_id], references: [id])

  created_at          DateTime            @default(now())

  billItem            BillItem[]
  billPaymentsEntry   BillPaymentsEntry[]
  oldGoldEntry        OldGoldEntry[]

  @@index([shop_id])
  @@index([customer_id])
  @@index([created_by_user_id])
}

model BillItem {
  id            String            @id @default(uuid())
  bill_id       String 
  bill          Bill              @relation(fields: [bill_id], references: [id])
  category_id   String 
  category      JewelleryCategory @relation(fields: [category_id], references: [id])
  purity        Purity?           @default(K22)
  metal         Metal             @default(GOLD)
  gross_weight  Float             @default(0)
  net_weight    Float             @default(0)
  stone         Float?            @default(0)
  wastage       Float?
  rate          Float
  making_charge Float
  amount        Float 
}

model JewelleryCategory {
  id                    String                @id @default(uuid())
  shop_id               String
  shop                  Shop                  @relation(fields: [shop_id], references: [id])
  name                  String
  metal                 Metal                 @default(GOLD)
  default_wastage       Float?
  default_making_charge Float?
  touch_22k             Float?
  touch_18k             Float?
  touch_24k             Float?
  created_at            DateTime              @default(now())

  inventoryStockEntry   InventoryStockEntry[]
  billItem              BillItem[]
  approvalItems         ApprovalItem[]
}

// Gold / Silver Loan ------------------------------

model JewelLoan {
  id                  String               @id @default(uuid())
  shop_id             String 
  shop                Shop                 @relation(fields: [shop_id], references: [id])
  customer_id         String 
  customer            Customer             @relation(fields: [customer_id], references: [id])
  loan_number         String
  loan_amount         Int
  interest_rate       Float
  gross_weight        Float 
  net_weight          Float
  jewellery_photo_url String?
  customer_photo_url  String?
  status              LoanStatus           @default(ACTIVE)
  loan_date           DateTime             @default(now())
  notes               String?
  created_at          DateTime             @default(now())

  loanCollateralItem  LoanCollateralItem[]
  loanRepayment       LoanRepayment[]
}

model LoanCollateralItem {
  id           String    @id @default(uuid())
  loan_id      String 
  loan         JewelLoan @relation(fields: [loan_id], references: [id], onDelete: Cascade) 
  metal        Metal     @default(GOLD)
  description  String 
  purity       Purity?   
  pieces       Int       @default(1)
  gross_weight Float?    @default(0)
  net_weight   Float?    @default(0)
}

model LoanRepayment {
  id              String    @id @default(uuid())
  loan_id         String 
  loan            JewelLoan @relation(fields: [loan_id], references: [id], onDelete: Cascade) 
  principal_paid  Int
  interest_paid   Int 
  discount_amount Int?      @default(0)
  payment_date    DateTime
  notes           String?
  created_at      DateTime  @default(now())
}

// Inventory & Payments ----------------------------

model InventoryStockEntry {
  id                 String            @id @default(uuid())
  shop_id            String 
  shop               Shop              @relation(fields: [shop_id], references: [id])
  category_id        String
  category           JewelleryCategory @relation(fields: [category_id], references: [id])
  type               Type
  weight             Float
  purity             Purity
  stockType          StockType
  reference          ReferenceType
  reference_id       String?
  created_by_user_id String?
  created_by         User?             @relation("StockCreatedByUser", fields: [created_by_user_id], references: [id])
  created_at         DateTime          @default(now())

  @@index([shop_id])
  @@index([created_by_user_id])
}

model BillPaymentsEntry {
  id                 String   @id @default(uuid())
  shop_id            String 
  shop               Shop     @relation(fields: [shop_id], references: [id])
  bill_id            String
  bill               Bill     @relation(fields: [bill_id], references: [id])
  paid_amount        Float 
  created_by_user_id String?
  created_by         User?    @relation("PaymentCreatedByUser", fields: [created_by_user_id], references: [id])
  created_at         DateTime @default(now())

  @@index([shop_id])
  @@index([created_by_user_id])
}

model OldGoldEntry {
  id        String @id @default(uuid())
  shop_id   String
  shop      Shop   @relation(fields: [shop_id], references: [id])
  bill_id   String
  bill      Bill   @relation(fields: [bill_id], references: [id])
  item_name String
  purity    String
  weight    Float
  rate      Float
  amount    Float
}

model ShopSetting {
  id               String   @id @default(uuid())   

  shop_id          String   @unique
  shop             Shop     @relation(fields: [shop_id], references: [id])

  // Basic
  shop_name        String
  owner_name       String?
  address          String?
  phone            String?
  whatsapp         String?
  email            String?

  // Tax
  gstin            String?
  pan              String?

  // Invoice & Scheme
  invoice_prefix   String?  @default("BILL-")
  estimate_prefix  String?  @default("EST-")
  scheme_prefix    String?  @default("GS-")
  terms_conditions String?

  // Bank
  bank_name        String?
  account_name     String?
  account_number   String?
  ifsc             String?
  branch           String?
  upi_id           String?

  // Branding
  logo_url         String?
  signature_url    String?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Plan {
  id                     String         @id @default(uuid())
  name                   String         @unique
  price                  Int            // monthly price in paise
  max_users              Int            @default(1)
  max_invoices_per_month Int?
  max_branches           Int            @default(1)
  features               Json?
  note                   String?
  is_active              Boolean        @default(true)
  subscriptions          Subscription[]
}

model Subscription {
  id                       String             @id @default(uuid())
  shop_id                  String
  shop                     Shop               @relation(fields: [shop_id], references: [id])
  plan_id                  String
  plan                     Plan               @relation(fields: [plan_id], references: [id])

  duration_months          Int
  amount_paid              Int
  discount_percent         Int                @default(0)

  razorpay_subscription_id String?            @unique
  status                   subscriptionStatus @default(TRIAL)
  current_period_start     DateTime?
  current_period_end       DateTime?

  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  @@index([shop_id])
  @@index([status])
  @@index([plan_id])
}

model PlatformConfig {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @updatedAt
}

// B2B Peer Shop / Dealer Consignment & Approval (வெளிக்கடை & ஜாங்கட்)

enum ApprovalStatus {
  OUTWARD
  PARTIAL_RETURN
  COMPLETED
  CANCELLED
}

enum ApprovalItemStatus {
  PENDING
  PARTIAL
  RETURNED
  SOLD
}

enum SettlementMode {
  PURE_GOLD
  CASH
  SCRAP_GOLD
}

model Dealer {
  id                   String             @id @default(uuid())
  shop_id              String
  shop                 Shop               @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  name                 String
  shop_name            String
  phone                String
  address              String?
  city                 String?
  opening_pure_balance Float              @default(0)
  notes                String?
  is_active            Boolean            @default(true)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  approvalMemos        ApprovalMemo[]
  settlements          DealerSettlement[]

  @@index([shop_id])
  @@index([phone])
}

model ApprovalMemo {
  id                 String             @id @default(uuid())
  shop_id            String
  shop               Shop               @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  dealer_id          String
  dealer             Dealer             @relation(fields: [dealer_id], references: [id], onDelete: Cascade)
  voucher_number     String
  status             ApprovalStatus     @default(OUTWARD)
  date               DateTime           @default(now())
  notes              String?
  created_by_user_id String?
  created_by         User?              @relation("ApprovalCreatedByUser", fields: [created_by_user_id], references: [id])
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  items              ApprovalItem[]

  @@index([shop_id])
  @@index([dealer_id])
}

model ApprovalItem {
  id               String             @id @default(uuid())
  approval_id      String
  approval         ApprovalMemo       @relation(fields: [approval_id], references: [id], onDelete: Cascade)
  category_id      String?
  category         JewelleryCategory? @relation(fields: [category_id], references: [id])
  item_name        String
  metal            Metal              @default(GOLD)
  purity           Purity?            @default(K22)
  touch            Float              // Touch percentage e.g. 91.6, 92.0, 75.0
  pieces_out       Int                @default(1)
  gross_weight_out Float              @default(0)
  net_weight_out   Float              @default(0)
  pieces_in        Int                @default(0)
  gross_weight_in  Float              @default(0)
  net_weight_in    Float              @default(0)
  sold_pieces      Int                @default(0)
  sold_net_weight  Float              @default(0)
  pure_weight      Float              @default(0) // sold_net_weight * (effective_touch / 100)
  hallmark_charge  Float?             @default(0) // Optional hallmark charge per item / memo line
  status           ApprovalItemStatus @default(PENDING)
  returned_at      DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  @@index([approval_id])
}

model DealerSettlement {
  id                   String         @id @default(uuid())
  shop_id              String
  shop                 Shop           @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  dealer_id            String
  dealer               Dealer         @relation(fields: [dealer_id], references: [id], onDelete: Cascade)
  settlement_number    String
  payment_mode         SettlementMode @default(PURE_GOLD)
  pure_weight_received Float          // Pure gold grams credited to dealer balance
  gross_weight         Float?         // If scrap metal
  touch                Float?         // If scrap metal touch
  cash_amount          Float?         // If cash payment received
  pure_gold_rate       Float?         // Rate used to convert cash to pure gold grams
  date                 DateTime       @default(now())
  notes                String?
  created_by_user_id   String?
  created_by           User?          @relation("SettlementCreatedByUser", fields: [created_by_user_id], references: [id])
  created_at           DateTime       @default(now())

  @@index([shop_id])
  @@index([dealer_id])
}

// Gold Savings Scheme (Flexi Gold Chit / Digi-Gold) ------------------

enum SchemeStatus {
  ACTIVE
  REDEEMED
  CLOSED
}

enum SchemePaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

model GoldSavingsAccount {
  id                   String                 @id @default(uuid())
  shop_id              String
  shop                 Shop                   @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  customer_id          String
  customer             Customer               @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  account_number       String
  title                String?                @default("Flexi Gold Scheme")
  target_grams         Float?                 @default(0)
  target_amount        Float?                 @default(0)
  total_cash_deposited Float                  @default(0)
  total_gold_grams     Float                  @default(0)
  total_gold_redeemed  Float                  @default(0)
  status               SchemeStatus           @default(ACTIVE)
  notes                String?
  created_by_user_id   String?
  created_by           User?                  @relation("SchemeCreatedByUser", fields: [created_by_user_id], references: [id])
  redeemed_at          DateTime?
  redeemed_bill_id     String?
  redeemed_notes       String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  payments             GoldSavingsPayment[]
  redemptions          GoldSavingsRedemption[]

  @@index([shop_id])
  @@index([customer_id])
  @@index([status])
}

model GoldSavingsPayment {
  id                 String             @id @default(uuid())
  shop_id            String
  shop               Shop               @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  account_id         String
  account            GoldSavingsAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  receipt_number     String
  payment_date       DateTime           @default(now())
  cash_amount        Float
  gold_rate_applied  Float              // 22K (916) rate per gram applied at deposit time
  grams_credited     Float              // (cash_amount / gold_rate_applied)
  payment_mode       SchemePaymentMode  @default(CASH)
  transaction_ref    String?
  notes              String?
  created_by_user_id String?
  created_by         User?              @relation("SchemePaymentCreatedByUser", fields: [created_by_user_id], references: [id])
  created_at         DateTime           @default(now())

  @@index([shop_id])
  @@index([account_id])
}

model GoldSavingsRedemption {
  id                 String             @id @default(uuid())
  shop_id            String
  shop               Shop               @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  account_id         String
  account            GoldSavingsAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  voucher_number     String
  redemption_date    DateTime           @default(now())
  grams_redeemed     Float              // Gold grams debited/redeemed (e.g. 5.000)
  gold_rate_applied  Float              // 22K (916) rate per gram applied at redemption
  cash_equivalent    Float              // grams_redeemed * gold_rate_applied
  bill_number        String?
  notes              String?
  created_by_user_id String?
  created_by         User?              @relation("SchemeRedemptionCreatedByUser", fields: [created_by_user_id], references: [id])
  created_at         DateTime           @default(now())

  @@index([shop_id])
  @@index([account_id])
}